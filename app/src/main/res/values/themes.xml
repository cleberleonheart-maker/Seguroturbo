<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema escuro (o app é todo escuro/neon) para evitar "flash" claro na abertura. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/neon_cyan</item>
        <item name="colorPrimaryDark">@color/neon_purple</item>
        <item name="colorAccent">@color/neon_magenta</item>
        <item name="android:windowBackground">@color/bg_deep</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/bg_deep</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/bg_deep</item>
        <!-- Android 12+: alinha o splash do sistema ao fundo do app (sem flash branco). -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">@color/bg_deep</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
