    <string-array name="changelog_1_27_1_novidades" />
    <string-array name="changelog_1_27_1_correcoes">
        <item>Touch test response unit now follows the device language.</item>
        <item>Removed unused strings, slightly shrinking the APK.</item>
    </string-array>
    <string-array name="changelog_1_27_2_novidades" />
    <string-array name="changelog_1_27_2_correcoes">
        <item>Gradle Wrapper com distributionSha256Sum para maior segurança.</item>
        <item>Pequenos ajustes para preparação do F-Droid.</item>
    </string-array>

    <string-array name="changelog_1_27_novidades">
        <item>Instrumented tests (Compose UI) for the main flows, running on device/emulator.</item>
    </string-array>
    <string-array name="changelog_1_27_correcoes" />
    <string-array name="changelog_1_26_novidades">
        <item>Screen/touch test: measures touch response, taps per second and multitouch.</item>
    </string-array>
    <string-array name="changelog_1_26_correcoes" />
    <string-array name="changelog_1_25_novidades">
        <item>Network test in the Benchmark: measures your connection\'s latency and download speed.</item>
    </string-array>
    <string-array name="changelog_1_25_correcoes" />
    <string-array name="changelog_1_24_novidades">
        <item>RAM cleanup: choose which apps to close (background processes) to free up memory, with a RAM usage indicator.</item>
    </string-array>
    <string-array name="changelog_1_24_correcoes" />
    <string-array name="changelog_1_23_novidades">
        <item>Expanded integrity detection: root, SELinux status (Enforcing/Permissive) and signs of an unlocked bootloader, with an explanation for each case.</item>
    </string-array>
    <string-array name="changelog_1_23_correcoes" />
    <string-array name="changelog_1_22_novidades">
        <item>Permission audit: see which apps have access to the camera, microphone, location, SMS, contacts and more.</item>
    </string-array>
    <string-array name="changelog_1_22_correcoes" />
    <string-array name="changelog_1_21_novidades" />
    <string-array name="changelog_1_21_correcoes">
        <item>Fixed the “couldn\'t download the update” error — the download now runs off the main thread.</item>
    </string-array>
    <string-array name="changelog_1_20_novidades">
        <item>Floating in-game bar: clock, battery and RAM with shortcuts for screenshot, recording, Do Not Disturb, Wi‑Fi, brightness and timer.</item>
        <item>The bar appears automatically when you open a game from Game Turbo.</item>
    </string-array>
    <string-array name="changelog_1_20_correcoes" />
    <string-array name="changelog_1_19_novidades">
        <item>Share the benchmark score evolution chart as an image.</item>
    </string-array>
    <string-array name="changelog_1_19_correcoes" />
    <string-array name="changelog_1_18_novidades">
        <item>A What\'s new screen: a list of what was added and fixed in each version.</item>
    </string-array>
    <string-array name="changelog_1_18_correcoes">
        <item>Fixed the “couldn\'t download the update” error on some devices.</item>
        <item>If the direct download fails, the app opens the release page in the browser.</item>
    </string-array>
    <string-array name="changelog_1_17_novidades">
        <item>French language support (the app now speaks Portuguese, English, Spanish and French).</item>
    </string-array>
    <string-array name="changelog_1_17_correcoes" />
    <string-array name="changelog_1_16_novidades">
        <item>Backup and restore of your preferences and history to a file.</item>
        <item>Automatic check for new versions once a day in the background.</item>
    </string-array>
    <string-array name="changelog_1_16_correcoes" />

    <string name="trava_titulo">Lock screen when opening a game</string>
    <string name="trava_desc">Pins the game to the screen (screen pinning). To exit, touch and hold Back + Recents</string>
    <string name="trava_sistema_desativado">Screen pinning is disabled in system settings. Enable it to use this option.</string>
    <string-array name="changelog_1_28_novidades">
        <item>Screen pinning: pin the game to the screen when you open it, avoiding accidental taps; to exit, touch and hold Back + Recents.</item>
    </string-array>
    <string-array name="changelog_1_28_correcoes" />
    <string name="som_titulo">Mute only media in game</string>
    <string name="som_desc">Lowers music and video volume (media stream) in Game Mode; ringtones, alarms and calls stay audible</string>
    <string-array name="changelog_1_29_novidades">
        <item>Mute only media: in Game Turbo, lowers music and video volume during Game Mode, without affecting calls, alarms and notifications.</item>
