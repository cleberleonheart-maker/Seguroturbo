<?xml version="1.0" encoding="utf-8"?>
<!-- Atalhos de toque longo no ícone do app (App Shortcuts, Android 7.1+). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <shortcut
        android:shortcutId="seguranca"
        android:enabled="true"
        android:icon="@drawable/ic_security"
        android:shortcutShortLabel="@string/nav_seguranca"
        android:shortcutLongLabel="@string/sec_title">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.seguraturbo.app"
            android:targetClass="com.seguraturbo.app.MainActivity">
            <extra
                android:name="tela"
                android:value="seguranca" />
        </intent>
    </shortcut>

