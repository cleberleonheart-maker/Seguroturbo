<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Notificações do lembrete de verificação (opcional; o usuário pode negar). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Consulta o GitHub para verificar se há uma versão mais nova do app. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Permite baixar e instalar a atualização da própria release (auto-update).
         O usuário ainda precisa autorizar "instalar apps desconhecidos" para o app. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Permite ativar o modo Não Perturbe junto com o Modo Jogo (Game Turbo).
         O usuário ainda precisa conceder o acesso de política de notificação. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- Permite ler os apps com atividade de launcher para acharmos os jogos e
         consultar pacotes conhecidos de root na checagem de integridade. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
        <package android:name="com.topjohnwu.magisk" />
        <package android:name="com.noshufou.android.su" />
        <package android:name="com.noshufou.android.su.elite" />
        <package android:name="eu.chainfire.supersu" />
        <package android:name="com.koushikdutta.superuser" />
        <package android:name="com.thirdparty.superuser" />
        <package android:name="com.yellowes.su" />
        <package android:name="com.kingroot.kinguser" />
        <package android:name="com.zhiqupk.root.global" />

        <!-- Pacotes conhecidos de stalkerware/ratware: declarados aqui para que o
             detector consiga enxergá-los mesmo quando o app se esconde da lista. -->
        <package android:name="com.mspy.mobile" />
        <package android:name="com.mspy.pro" />
        <package android:name="com.bsbsoft.mspy" />
        <package android:name="com.cyberlink.mobiletracker" />
        <package android:name="com.cocospy.android" />
        <package android:name="com.spyzie.android" />
        <package android:name="com.hoverwatch.mobile" />
        <package android:name="com.kidguard.monitor" />
        <package android:name="com.iosnoops" />
        <package android:name="com.spyera.android" />
        <package android:name="com.minspy.monitor" />
        <package android:name="com.flexispy.android" />
        <package android:name="com.mobiletracker.android" />
        <package android:name="com.thetruthspy.guardian" />
        <package android:name="com.xnspy.android" />
        <package android:name="com.spyic.mobile" />
        <package android:name="com.highster.mobile" />
        <package android:name="com.mobiletracker.monitor" />
        <package android:name="com.wt.spy" />
        <package android:name="com.familykeylogger" />
        <package android:name="net.omniwave.spyphone" />
        <package android:name="com.aim.spyphone" />
        <package android:name="com.hiddenapp.hidespy" />
        <package android:name="com.spyphone.android" />
    </queries>

    <!-- Barra flutuante do Game Turbo sobre o jogo (o usuário precisa autorizar
         "sobrepor a outros apps"). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Serviço em primeiro plano que mantém a barra e a captura de tela ativas. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Ajusta o brilho da tela pela barra (o usuário concede o acesso pela tela
         "Modificar configurações do sistema", via ACTION_MANAGE_WRITE_SETTINGS). -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Consulta o estado da rede (Wi‑Fi, VPN e DNS privado) para o scan.
         São permissões normais, sem pedido ao usuário. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Permite encerrar os processos em segundo plano dos apps escolhidos pelo
         usuário na "Limpeza de RAM". É uma permissão normal, sem prompt. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Compartilha a imagem do relatório gerado em cache. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Recebe o alarme do lembrete de verificação. -->
        <receiver
            android:name=".util.LembreteReceiver"
            android:exported="false" />

        <!-- Recebe os alarmes do Turbo agendado (liga/desliga o Modo Jogo). -->
        <receiver
            android:name=".util.TurboAgendadoReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.seguraturbo.app.TURBO_AGENDADO_LIGAR" />
                <action android:name="com.seguraturbo.app.TURBO_AGENDADO_DESLIGAR" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Recebe os alarmes do Não Perturbe agendado. -->
        <receiver
            android:name=".util.DndAgendadoReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.seguraturbo.app.DND_AGENDADO_LIGAR" />
                <action android:name="com.seguraturbo.app.DND_AGENDADO_DESLIGAR" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Widget da tela inicial. -->
        <receiver
            android:name=".widget.SeguroTurboWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.seguraturbo.app.widget.LIMPAR_RAM" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!-- Barra flutuante do Game Turbo (por cima do jogo). -->
        <service
            android:name=".service.ServicoBarraJogo"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="game_overlay_bar" />
        </service>

        <!-- Captura de tela e gravação de vídeo (projeção de tela). -->
        <service
            android:name=".service.ServicoCaptura"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Pede o consentimento de captura de tela (transparente). -->
        <activity
            android:name=".service.PedirCapturaActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>

</manifest>
